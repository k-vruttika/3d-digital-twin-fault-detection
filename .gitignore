# Python
.venv/
__pycache__/
*.py[cod]
*.egg-info/
.mypy_cache/
.ruff_cache/
.pytest_cache/
.coverage
htmlcov/
build/
dist/

# Node / frontend
node_modules/
frontend/dist/
frontend/coverage/
frontend/test-results/
frontend/playwright-report/
*.tsbuildinfo

# Data and ML artefacts (never committed)
data/*
!data/.gitkeep
mlruns/
mlartifacts/
*.onnx
*.pt

# Generated experiment results: produced by scripts and committed (CLAUDE.md section 7).
# Reports (*.md), JSON summaries and plots (*.png, *.svg) are tracked. Large or regenerable
# artefacts are not. Git cannot filter by size: tests/test_results_policy.py fails if a tracked or
# untracked-but-not-ignored file here exceeds the size limit.
experiments/results/**/*.parquet
experiments/results/**/*.feather
experiments/results/**/*.arrow
experiments/results/**/*.npy
experiments/results/**/*.npz
experiments/results/**/*.pkl
experiments/results/**/*.joblib
experiments/results/**/*.ckpt
experiments/results/**/*.pt
experiments/results/**/*.pth
experiments/results/**/*.onnx
experiments/results/**/*.h5
experiments/results/**/*.sqlite
experiments/results/**/*.db
experiments/results/**/*.csv.gz
experiments/results/**/*.zip
experiments/results/**/mlruns/
experiments/results/**/raw/

# Local services / env
.env
.env.*
!.env.example
*.log
mosquitto.db
config/*.local.yaml

# Editors / OS
.vscode/*
!.vscode/extensions.json
.idea/
Thumbs.db
Desktop.ini
.DS_Store
