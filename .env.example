# Copy to .env (gitignored) and adjust. Read by Docker Compose (docker-compose.yml) and by the
# Python settings (twin_common.config.TwinSettings, prefix LINETWIN_), so both always agree.
# Local development values only - never reuse these credentials elsewhere.

LINETWIN_PG_DB=linetwin
LINETWIN_PG_USER=linetwin
LINETWIN_PG_PASSWORD=linetwin-dev
# Host port for TimescaleDB (bound to 127.0.0.1). Change it if a native PostgreSQL uses 5432.
LINETWIN_PG_PORT=5432
